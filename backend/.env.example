# Copy this file to .env and replace the placeholder values.
PORT=5000
NODE_ENV=development

# Database connection string.
# Local MongoDB example:
#   MONGO_URI=mongodb://127.0.0.1:27017/meridiana
# MongoDB Atlas example (replace user, password and cluster name):
#   MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/meridiana?retryWrites=true&w=majority
# After changing this value, test it with: npm run db:check
MONGO_URI=mongodb://127.0.0.1:27017/meridiana

# Use a long random string, e.g. generated with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# The Next.js frontend address (used for CORS)
CLIENT_URL=http://localhost:3000

# Document upload limit
MAX_FILE_SIZE_MB=10

# Optional first administrator. npm run dev creates this account on first start.
# For a real database, set these values and run npm run seed:admin.
SEED_ADMIN_NAME=Meridiana Administrator
SEED_ADMIN_EMAIL=admin@meridiana.local
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
