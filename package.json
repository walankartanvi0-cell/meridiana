{
  "name": "meridiana",
  "version": "1.0.0",
  "private": true,
  "description": "Meridiana M&A advisory platform - root commands for the frontend and backend",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "db:check": "npm --prefix backend run db:check",
    "seed:admin": "npm --prefix backend run seed:admin",
    "typecheck": "npm --prefix backend run typecheck",
    "lint": "npm --prefix frontend run lint",
    "build": "npm --prefix backend run build && npm --prefix frontend run build"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
